# Copy to .env. SightMate's AI brain is any OpenAI-compatible server
# (Ollama / vLLM / LM Studio / OpenAI / Gemini / OpenRouter).
# The model MUST be vision-capable, since SightMate reads screenshots.

# Which brain to use:
#   local -> a real model via Ollama or another OpenAI-compatible server (the real app)
#   sample -> canned answers with no model, just for trying the flow
SIGHTMATE_BACKEND=local

# --- Local / open model (Ollama defaults). See LOCAL_SETUP.md. ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3-vl:8b

# To use a different OpenAI-compatible provider instead of Ollama, change the
# three lines above, e.g. OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini

# --- Voice backend ---
#   browser (default) -> speech in/out handled in the browser (Web Speech API)
#   server            -> route audio through server-side STT/TTS providers
# SIGHTMATE_VOICE=browser

# --- Misc ---
# SIGHTMATE_DB=sightmate.db
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
